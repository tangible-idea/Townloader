{
  "hosting": [
    {
      "target": "townloader",
      "public": "site/public",
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "/@(fonts|vendor|media)/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        },
        {
          "source": "/@(site.css|main.js)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
        }
      ]
    }
  ]
}
